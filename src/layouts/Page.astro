---
import Base from "./Base.astro";

import { localization } from "@i18n/index";

import StatusCafe from "@components/sidebar/StatusCafe.svelte";
import NewIndicator from "@components/posts/NewIndicator.svelte";
import { getCollection } from "astro:content";
import SidebarStats from "@components/sidebar/SidebarStats.svelte";
import { getRelativeLocaleUrl } from "astro:i18n";

const { title, description, og_img, og_img_alt } = Astro.props;
const locale = (Astro.currentLocale ?? "en") as keyof typeof localization;
const t = localization[locale];

const path = Astro.url.pathname;
const otherLocaleUrl = Astro.currentLocale === "cs" ? path.replace("/cs/", "/") : "/cs" + path;
const otherLocaleString = Astro.currentLocale === "cs" ? "English" : "Čeština";

let blog = await getCollection("blog");
blog = blog.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<Base title={title} description={description} og_img={og_img} og_img_alt={og_img_alt}>
  <div class="main-layout">
    <div class="sidebar">
      <SidebarStats locale={locale} client:only />
    </div>

    <div class="page-content">
      <header>
        <h1><a href={getRelativeLocaleUrl(locale, "/")}>f1sh.cz</a></h1>

        <nav>
          <a href={getRelativeLocaleUrl(locale, "/")}>{t.nav.home}</a>
          <a href={getRelativeLocaleUrl(locale, "/blog/")}>{t.nav.blog}</a>
          <a href={getRelativeLocaleUrl(locale, "/vinyl/")}>{t.nav.vinyls}</a>
          <a href={getRelativeLocaleUrl(locale, "/scrobbles/")}>{t.nav.scrobbles}</a>
          <a href={getRelativeLocaleUrl(locale, "/guestbook/")}>{t.nav.guestbook}</a>
          |
          <a class="lang-switch" href={otherLocaleUrl}>{otherLocaleString}</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <div>{t.footer.copyright.text}<a href="/license/">{t.footer.copyright.link}</a></div>
        <div>{t.footer.version.text}<a href="https://github.com/wirelessfish/website">{t.footer.version.link}</a></div>
      </footer>
    </div>

    <div class="sidebar">
      <StatusCafe locale={Astro.currentLocale as "en" | "cs"} client:only />

      <div style="display: flex; justify-content: center; margin-top: 1em;">
        <iframe
          width="150"
          height="450"
          style="border:none"
          src="https://dogspit.nekoweb.org/sidelink.html"
          name="sidelink"></iframe>
      </div>
    </div>
  </div>
</Base>

<style>
  html {
  }

  body {
    overflow: scroll;
    width: 100vw;
    min-height: 100vh;
  }

  footer {
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;
    gap: 1.5em;
    padding: 4px 8px;

    width: 100%;
    background-color: var(--black);
    border-top: 1px solid var(--grey);
    margin-top: 1rem;
  }

  main {
    flex: 1;
  }

  header {
    background-color: var(--black);

    display: flex;
    justify-content: space-between;
    align-items: end;

    padding: 8px 12px;

    h1 {
      font-family: "HS LunaObscura";
      font-size: 24px;
      line-height: 1em;

      a {
        text-decoration: none;
        padding: 0;
      }
    }
  }

  nav {
    display: flex;
    gap: 4px;

    .lang-switch {
      color: var(--orange);
    }

    .lang-switch:hover {
      color: var(--black);
      background-color: var(--orange);
    }
  }

  .header-title {
    border-bottom: 1px solid var(--grey);
    z-index: 10000;

    h1,
    a {
      margin: 0;
      padding: 0;

      text-decoration: none !important;
    }

    h1 {
      font-size: 28px;
      font-family: "HS LunaObscura";
      padding: 4px 16px;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-feature-settings: "ss01" 1;

      background: linear-gradient(to right, var(--black) 80%, transparent);
    }
  }

  .sidebar {
    height: 100%;
    background-color: var(--blacker);
  }

  .page-content {
    background-color: var(--blacker);
    width: 100%;
    height: 100%;
    min-height: 800px;
    flex: 1;
    display: flex;
    flex-direction: column;
    border-left: 4px solid var(--darkgrey);
    border-right: 4px solid var(--darkgrey);
  }

  .sidecard {
    background-color: var(--black);
    height: fit-content;
    border: 1px solid var(--grey);
    padding: 4px 8px;
    border-radius: 2px;
  }

  .main-layout {
    margin: 0px 128px;
    display: grid;
    grid-template-columns: 200px 800px 200px;
    height: 100%;
  }

  @media (max-width: 1000px) {
    .sidebar {
      display: none;
    }

    .main-layout {
      display: block;
      margin: 0;
      width: 100%;
    }

    header {
      display: block;
    }

    .page-content {
      width: 100%;
      border-radius: 0;
      border: none;
    }

    footer {
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
  }
</style>
