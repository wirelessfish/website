---
import Base from "./Base.astro";

import StatusCafe from "@components/sidebar/StatusCafe.svelte";
import FloatingImg from "@components/FloatingImg.svelte";
import NavElement from "@components/NavElement.astro";
import NewIndicator from "@components/posts/NewIndicator.svelte";
import { getCollection } from "astro:content";
import SidebarStats from "@components/sidebar/SidebarStats.svelte";

const { title, description, og_img, og_img_alt } = Astro.props;

let blog = await getCollection("blog");
blog = blog.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

let projects = await getCollection("projects");
projects = projects.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<Base title={title} description={description} og_img={og_img} og_img_alt={og_img_alt}>
  <div class="main-layout">
    <div class="sidebar">
      <SidebarStats client:only />
    </div>

    <div class="page-content">
      <header>
        <div class="header-title">
          <h1><a href="/">wireless.fish!</a></h1>
        </div>

        <nav>
          <NavElement href="/">Home</NavElement>
          <NavElement href="/collections/">Collections</NavElement>
          <NavElement href="/projects/">Projects<NewIndicator blog={projects} client:only /></NavElement>
          <NavElement href="/scrobbles/">Scrobbles</NavElement>
          <NavElement href="/guestbook/">Guestbook</NavElement>
          <NavElement href="/tools/">Tools</NavElement>
          <NavElement href="/blog/">Blog<NewIndicator blog={blog} client:only /></NavElement>
        </nav>
      </header>

      <slot />

      <footer>
        <div>© Sharky 2025-2026 <a class="link-button" href="/license/">➙</a></div>

        <div>
          ♡ Copying is an act of theft, while taking inspiration is the true act of love.
          <a class="link-button" href="https://maxpixels.moe/manifesto/">➟</a>
        </div>

        <div>Version 4.2 - <a href="https://github.com/wirelessfish/website">Source code ➟</a></div>
      </footer>
    </div>

    <div class="sidebar">
      <StatusCafe client:only />

      <div style="display: flex; justify-content: center; margin-top: 1em;">
        <iframe
          width="150"
          height="450"
          style="border:none"
          src="https://dogspit.nekoweb.org/sidelink.html"
          name="sidelink"></iframe>
      </div>
    </div>
  </div>
</Base>

<style>
  html {
  }

  body {
    overflow: scroll;
    width: 100vw;
    min-height: 100vh;
  }

  footer {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 1.5em;
    padding: 4px 8px;

    width: 100%;
    background-color: var(--black);
    border-top: 1px solid var(--grey);
    margin-top: 1em;
  }

  nav {
    border-bottom: 1px solid var(--grey);
    background-color: var(--darkergrey);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    gap: 0;
    width: 100%;
    gap: 1em;
    padding: 0.5em 1em;

    * {
      flex: 1;
      text-align: center;
      padding: 2px 4px;
    }
  }

  header {
    position: sticky;
    top: 0;
    background-color: var(--black);
  }

  .header-title {
    border-bottom: 1px solid var(--grey);
    z-index: 10000;

    h1,
    a {
      margin: 0;
      padding: 0;

      text-decoration: none !important;
    }

    h1 {
      font-size: 28px;
      font-family: "HS LunaObscura";
      padding: 4px 16px;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-feature-settings: "ss01" 1;

      background: linear-gradient(to right, var(--black) 80%, transparent);
    }
  }

  .sidebar {
    height: 100%;
    margin-top: 128px;
  }

  .page-content {
    background-color: var(--blacker);
    width: 100%;
    height: 100%;
    min-height: 600px;
    flex: 1;
    border-radius: 2px;
    border: 1px solid var(--lightgrey);
  }

  .sidecard {
    background-color: var(--black);
    height: fit-content;
    border: 1px solid var(--grey);
    padding: 4px 8px;
    border-radius: 2px;
  }

  .main-layout {
    margin: 40px 128px;
    display: grid;
    grid-template-columns: 200px 1000px 200px;
    gap: 1em;
    height: 100%;
  }

  @media (max-width: 1000px) {
    .sidebar {
      display: none;
    }

    .main-layout {
      display: block;
      margin: 0;
    }

    .page-content {
      width: 100%;
      border-radius: 0;
      border: none;
    }

    footer {
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
  }
</style>
