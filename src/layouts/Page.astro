---
import Blank from "@layouts/Blank.astro";

const { title, description, og_img, og_img_alt } = Astro.props;
---

<Blank title={title} description={description} og_img={og_img} og_img_alt={og_img_alt}>
  <div class="main-layout">
    <header>
      <a href="/" class="header-img"></a>
      <nav>
        <a href="/">Home</a>
        <a href="/blog/">Blog</a>
        <a href="/vinyl/">Vinyls</a>
        <a href="/guestbook/">Guestbook</a>
        <a href="/departures/">Departures</a>
        <a href="https://koito.kabeyai.net">Scrobbles</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div>© Sharky 2025-2026 <a href="/license/">[license]</a></div>
      <div>Version 5.0<a href="https://github.com/wirelessfish/website">[source code]</a></div>
    </footer>
  </div>
</Blank>

<style>
  body {
    overflow: scroll;
    width: 100vw;
    min-height: 100vh;
  }

  footer {
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;
    gap: 1.5em;
    padding: 4px 8px;

    width: 100%;
    background-color: var(--black);
    border-top: 1px solid var(--grey);
    margin-top: 1rem;
  }

  main {
    flex: 1;
  }

  header {
    background-color: var(--black);
    width: 100%;
    border-bottom: 1px solid var(--white);
  }

  nav {
    width: 100%;
    display: flex;
    border-top: 1px solid var(--white);

    a {
      padding: 2px 24px;
      text-decoration: none;
      color: var(--white);
    }
  }

  .header-img {
    height: 200px;
    width: 100%;
    display: block;
    background-image: url("/assets/header_title.webp");
    background-size: cover;
    background-position: center;
    image-rendering: pixelated;

    padding: 0;
  }

  .sidebar {
    height: 100%;
    background-color: var(--darkergrey);
  }

  .page-content {
    background-color: var(--darkergrey);
    width: 100%;
    height: 100%;
    min-height: 800px;
    flex: 1;
    display: flex;
    flex-direction: column;
    border-left: 2px solid var(--darkgrey);
    border-right: 2px solid var(--darkgrey);
  }

  .main-layout {
    width: 800px;
    margin: 32px;
    background-color: var(--black);
    border: 1px solid var(--white);
  }

  .simple-analytics > a,
  .simple-analytics > a:hover {
    background: none;
    padding: 0;
  }

  .simple-analytics {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 1000px) {
    .sidebar {
      display: none;
    }

    .main-layout {
      display: block;
      margin: 0;
      width: 100%;
    }

    header {
      display: block;
    }

    .page-content {
      width: 100%;
      border-radius: 0;
      border: none;
    }

    footer {
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
  }
</style>
