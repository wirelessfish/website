---
import Base from "@layouts/Base.astro";

const { title, description, og_img, og_img_alt } = Astro.props;
---

<Base title={title} description={description} og_img={og_img} og_img_alt={og_img_alt}>
  <slot />
</Base>

<style>
  html {
    background: var(--blacker);
  }

  body {
    min-height: 80vh;
    padding: 64px;

    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media (max-width: 800px) {
    body {
      padding: 16px;
    }
  }
</style>
