---
import Page from "./Page.astro";

import FormatAgo from "@components/FormatAgo.svelte";
import { format } from "date-fns";
const { frontmatter } = Astro.props;

const updated_str = frontmatter.updated;

const published = new Date(frontmatter.published);
const updated = updated_str ? new Date(updated_str) : undefined;
---

<Page
  title={frontmatter.title || "METHOD: POST"}
  description={frontmatter.description || "I wrote about something"}
  og_img={frontmatter.og_img}
  og_img_alt={frontmatter.og_img_alt}
>
  <div class="content-padding">
    <div class="post-head">
      <h2>{frontmatter.title}</h2>
      <div class="date">
        <span>
          Published: {format(published, "yyyy/MM/dd")} (<FormatAgo client:only date={published} format="round" />)
        </span>

        {
          updated ? (
            <>
              <span>
                Last updated: {format(updated, "yyyy/MM/dd")} (<FormatAgo client:only date={updated} format="round" />)
              </span>
            </>
          ) : (
            ""
          )
        }
      </div>
    </div>

    <slot />
  </div>
</Page>

<style>
  h2 {
    margin: 0;
  }

  .date {
    opacity: 70%;
    font-style: italic;

    display: flex;
    gap: 1em;
  }
</style>
