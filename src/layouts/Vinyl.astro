---
import Hint from "@components/Hint.astro";
import VinylBase from "@layouts/VinylBase.astro";

import { getCollection } from "astro:content";
import { localization } from "@i18n/index";

const vinylCollection = await getCollection("vinyls");

type Props = {
  frontmatter: (typeof vinylCollection)[0]["data"];
};

const { frontmatter }: Props = Astro.props;

const locale = (Astro.currentLocale ?? "en") as keyof typeof localization;
const t = localization[locale];
---

<VinylBase
  title={frontmatter.title}
  description={t.vinyl.pageAboutThe + frontmatter.title + t.vinyl.albumBy + frontmatter.artist}
>
  <div class="content">
    <a class="back" href="/vinyl/">&lt;&lt;&lt; {t.vinyl.back}</a>

    <div class="header">
      <h2>{frontmatter.title}</h2>
      <p class="artist">{frontmatter.artist} {frontmatter.albumYear}</p>
      {
        frontmatter.edition ? (
          <p>
            {frontmatter.edition} {frontmatter.editionYear ? "(" + frontmatter.editionYear + ")" : ""}
          </p>
        ) : (
          ""
        )
      }
      <Hint>({t.vinyl.clickForFullRes})</Hint>
    </div>

    <slot />
  </div>
</VinylBase>

<style>
  .back {
    color: var(--white);
  }

  .back:hover {
    background-color: var(--white);
    color: var(--blacker);
  }

  .content {
    max-width: 800px;
    width: 100%;
    background: var(--blacker);
    padding: 32px;
  }

  h2 {
    margin-bottom: 0;
  }

  .artist {
    font-style: italic;
  }

  .header {
    margin-bottom: 1rem;
  }
</style>
