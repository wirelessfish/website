---
import VinylBase from "@layouts/VinylBase.astro";

import { getCollection } from "astro:content";

const vinylCollection = await getCollection("vinyls");

type Props = {
  frontmatter: (typeof vinylCollection)[0]["data"];
};

const { frontmatter }: Props = Astro.props;
---

<VinylBase
  title={frontmatter.title}
  description={"A page about the " + frontmatter.title + " album by " + frontmatter.artist}
>
  <div class="content">
    <a class="back" href="/vinyl/">&lt;&lt;&lt; Go back</a>

    <div class="header">
      <h2>{frontmatter.title}</h2>
      <p class="artist">{frontmatter.artist} {frontmatter.albumYear}</p>
      {
        frontmatter.edition ? (
          <p>
            {frontmatter.edition} {frontmatter.editionYear ? "(" + frontmatter.editionYear + ")" : ""}
          </p>
        ) : (
          ""
        )
      }
      <p></p>
    </div>

    <slot />
  </div>
</VinylBase>

<style>
  .back {
    color: var(--white);
  }

  .back:hover {
    background-color: var(--white);
    color: var(--blacker);
  }

  .content {
    max-width: 800px;
    width: 100%;
  }

  h2 {
    margin-bottom: 0;
  }

  .artist {
    font-style: italic;
  }

  .header {
    margin-bottom: 1rem;
  }
</style>
