---
import "@styles/style.css"
import TabBar from "@components/TabBar.astro";
import TabElement from "@components/TabElement.astro";
import { colors } from "@scripts/colors";
import SiteStatsCompact from "@components/SiteStatsCompact.svelte";
import StatusCafe from "@components/StatusCafe.svelte";
import FloatingImg from "@components/FloatingImg.svelte";
import RecentScrobble from "@components/RecentScrobble.svelte";
import NavElement from "@components/NavElement.astro";
import NewIndicator from "@components/posts/NewIndicator.svelte";
import { getCollection } from "astro:content";

const {title, description, og_img} = Astro.props;

const color_vars = `:root {\n${Object.entries(colors)
  .map(([k, v]) => `  --${k}: ${v};`)
  .join('\n')}\n}`;

let blog = await getCollection("blog");
blog = blog.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<style set:html={color_vars} is:global></style>

<style>
  html {
    
  }

  body {
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: scroll;
    width: 100vw;
    min-height: 100vh;
  }

  footer {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 1.5em;

    width: 100%;
    background-color: var(--black);
  }

  nav {
    border-bottom: 1px solid var(--grey);
    background-color: var(--darkergrey);
    display: flex;
    justify-content: space-evenly;
    gap: 0;
    width: 100%;
    gap: 1em;
    padding: 0.5em 1em;

    * {
      flex: 1;
      text-align: center;
      padding: 2px 0px;
    }
  }

  header {
    position: sticky;
    top: 0;
    background-color: var(--black);
  }

  .header-title {
    background-image: url("/header.jpg");
    border-bottom: 1px solid var(--grey);
    display: flex;
    justify-content: space-between;
    flex-direction: row;
    z-index: 10000;

    h1, a {
      margin: 0;
      padding: 0;

      text-decoration: none !important;
    }

    h1 {
      font-size: 28px;
      font-family: "HS LunaObscura";
      padding: 4px 16px;
      width: 450px;
      text-align: left;
      display: flex;
      align-items: center;
      font-feature-settings: "ss01" 1;

      background: linear-gradient(to right, var(--black) 80%, transparent);
    }
  }

  .sidebar {
    height: 100%;
  }

  .content {
    background-color: var(--black);
    width: 1000px;
    height: 100%;
    flex: 1;
    margin: 40px 0px;
    border-radius: 4px;
    border: 2px solid var(--darkgrey);
  }

  .slot {
    /* overflow: visible; */
    /* overflow-y: scroll; */
  }

  .sidelink {
    margin-top: 256px;
    margin-left: 16px
  }

  .sidecard {
    background-color: var(--black);
    padding: 4px 8px;

    border: 1px solid var(--grey);
    border-right: none;
  }

  @media (max-width: 1000px) {
    .sidebar {display: none;}
    body {display: block;}
  }

  @media (max-width: 550px) {
    .header-title > h1 {font-size: 26px; background: var(--black); width: 100%; text-align: center;}
    .header-title {height: 120px; background-size: contain;}
  }
</style>

<!DOCTYPE html>

<html lang="en-US">
  <head>
    <!-- META -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={`https://wireless.fish${Astro.url}`}  />

    <link href="https://bsky.app/profile/wireless.fish" rel="me">

    <!-- SOME STUFF -->
    <title>{ title }</title>
    <meta name="description" content={ description } />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="alternate icon" type="image/png" href="/assets/favicon.png">

    <!-- https://ogp.me stuff -->
    <meta property="og:url" content={`https://wireless.fish${Astro.url}`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ title } />
    <meta property="og:locale" content="en_US" />
    
    {description ? (
      <meta property="og:description" content={ description } />
    ) : ""}

    { og_img ? (
      <meta property="og:image" content={ og_img } />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    ) : "" }

    <!-- twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ title } />
    
    { description ? (
      <meta name="twitter:description" content={ description } />
    ) : ""}

    { og_img ? (
      <meta name="twitter:image" content={ og_img } />
    ) : ""}
  </head>

  <body>
    <div class="content">
      <header>
          <div class="header-title">
            <h1><a href="/">wireless.fish!</a></h1>
            <SiteStatsCompact client:only />
          </div>
        
          <nav>
            <NavElement href="/">Home</NavElement>
            <NavElement href="/collections/">Collections</NavElement>
            <NavElement href="/scrobbles/">Scrobbles</NavElement>
            <NavElement href="/guestbook/">Guestbook</NavElement>
            <NavElement href="/tools/">Tools</NavElement>
            <NavElement href="/blog/">Blog<NewIndicator blog={blog} client:only/></NavElement>
          </nav>
      </header>

      <slot />
    </div>

    <footer>
      <div>© Sharky 2025-2026 <a class="link-button link-alt" href="/LICENSE.txt">➙</a></div>
      
      <div>
        ♡ Copying is an act of theft, while taking inspiration is the true act of love.
        <a class="link-button link-alt" href="https://maxpixels.moe/manifesto/">➟</a>
      </div>
      
      <div>SharkySite v4.2 - <a href="https://github.com/wirelessfish/website" class="link-alt">Source code ➟</a></div>
      </footer>
  </body>
</html>