---
import { getCollection } from "astro:content";
import { format } from "date-fns";

const vinylCollection = await getCollection("vinyls");

type Props = {
  entry: (typeof vinylCollection)[0];
};

const { entry }: Props = Astro.props;
---

<a class="entry" href={"/vinyls/" + entry.id}>
  <img src={entry.data.albumArt} alt={entry.data.albumArtAlt} loading="lazy" />

  <div class="info">
    <span class="info-title">{entry.data.title}</span>
    <span class="info-artist">{entry.data.artist} - {entry.data.albumYear}</span>

    <span class="info-edition">
      {entry.data.edition ? <>{entry.data.edition}</> : ""}
      {entry.data.editionYear ? <> ({entry.data.editionYear})</> : ""}
    </span>
  </div>
</a>

<style>
  .entry {
    position: relative;
    transition: 150ms;

    color: var(--white);
    text-decoration: none;
  }

  img {
    height: 256px;
  }

  .entry:hover {
    scale: 105%;
    background: none;

    .info {
      opacity: 100%;
    }
  }

  .info {
    opacity: 0%;

    transition: 150ms;
    position: absolute;
    bottom: 0px;

    padding: 8px;

    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    backdrop-filter: brightness(60%) blur(2px);

    text-shadow: 1px 1px 2px var(--black);
  }

  .info > span {
    text-align: center;
  }

  /* hover info styles */
  .info-title {
    font-size: 1.75rem;
    font-weight: bold;
  }

  .info-artist {
    font-style: italic;
  }

  .info-edition {
    color: var(--lightergrey);
  }
</style>
