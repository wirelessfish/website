---
const { title, description, date, image } = Astro.props;
---

<style>
  .thingimade {
    display: flex;

    background: linear-gradient(to bottom, var(--darkgrey), var(--darkergrey));

    border-top: 1px solid #474747;
    border-bottom: 1px solid #474747;
  }

  .img-wrapper {
    width: 230px;
    height: 100%;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
  }

  img {
    background-image: url("/assets/placeholder.svg");
    background-position: center;
    background-repeat: no-repeat;
    background-size: 30%;
    min-height: 128px;
    min-width: 128px;
  }

  h3 > span {
    font-weight: normal;
  }

  .thingimade_content {
    padding: 8px 16px;
  }

  .title {
    display: flex;
    justify-content: space-between;
    align-items: center;

    span {
      font-size: large;
      color: var(--lightgrey);
    }
  }

  @media (max-width: 800px) {
    .thingimade {
      flex-direction: column;
    }

    .img-wrapper {
      padding: 8px;
      display: flex;
      justify-content: center;
      width: 100%;
    }
  }
</style>

<div class="thingimade">
  <div class="img-wrapper">
    <img loading="lazy" src={image} />
  </div>

  <div class="thingimade_content">
    <div class="title">
      <h3>{title}</h3><span>{date}</span>
    </div>
    <slot />
  </div>
</div>
