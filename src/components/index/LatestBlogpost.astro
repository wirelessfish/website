---
import { getCollection } from "astro:content";
import { format } from "date-fns";

let blog = await getCollection("blog");
blog = blog.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
let post = blog[0];
let dateFormatted = format(post.data.published, "yyyy/MM/dd");
---

<div>
  <b>{post.data.title}</b> ({dateFormatted}) - {post.data.description}
  <a href={"/blog/" + post.id}>Read the full post...</a>
</div>

<style>
  a {
    margin-left: 2px;
  }
</style>
