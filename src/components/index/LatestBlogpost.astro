---
import { getCollection } from "astro:content";
import { format } from "date-fns";

let blog = await getCollection("blog");
blog = blog.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
let post = blog[0];
let dateFormatted = format(post.data.published, "yyyy/MM/dd");
---

<div class="latest-blogpost">
  <div class="heading">
    <h4>Latest blog entry: {post.data.title}</h4>
    <span>{dateFormatted}</span>
  </div>

  <div>
    {post.data.description}
    <a href={"/blog/" + post.id}>Read the full post...</a>
  </div>
</div>

<style>
  .latest-blogpost {
    border: 1px solid var(--grey);
    padding: 4px 8px;
    background-color: var(--darkergrey);
  }

  .heading {
    display: flex;
    justify-content: space-between;
  }

  span {
    color: var(--lightgrey);
  }

  a {
    margin-left: 2px;
  }
</style>
