---
const { href = "/" } = Astro.props;

const path = Astro.url.pathname;
const currentPage = path === href;
---

<style>
  a {
    text-align: center;
    text-decoration: none;
    padding: 2px 0px;
    border: 1px solid var(--grey);
    color: var(--white);
    box-shadow: 2px 2px 0px var(--grey);
    background-color: var(--darkergrey);
    border-radius: 2px;
  }

  a:hover {
    background-color: var(--white);
    color: var(--black);
    border: 1px solid var(--black);
  }

  .active-tab {
    color: var(--lightblue);
    border: 1px solid var(--lightblue);
    box-shadow: 2px 2px 0px var(--darklightblue);
  }
</style>

<a href={href} class:list={currentPage ? "active-tab" : ""}>
  <slot />
</a>
