---
let { src, alt, width, centered, click_src } = Astro.props;
---

<div class={centered ? "centered" : ""}>
  <a href={click_src ?? src}>
    <img src={src} alt={alt} width={width} />
  </a>
</div>

<style>
  a {
    display: block;
    padding: 0;
  }

  a:hover {
    background: none;
  }

  img {
    /* width: 100%; */
    height: auto;
    margin: 0;
  }

  .wrapper,
  .centered {
    display: flex;
    justify-content: center;
  }
</style>
