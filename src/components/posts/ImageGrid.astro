<div class="image-grid">
  <slot />
</div>

<style>
  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(128px, 1fr));
    gap: 16px;
  }

  .image-grid + .image-grid {
    margin-top: 16px;
  }

  @media (max-width: 800px) {
    .image-grid + .image-grid {
      margin-top: 8px;
    }

    .image-grid {
      gap: 8px;
    }
  }
</style>
