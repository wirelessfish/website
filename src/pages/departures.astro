---
import Blank from "@layouts/Blank.astro";
import eightyeight from "@data/eightyeight.json";
import EightyEightButton from "@components/EightyEightButton.astro";
import { createHash } from "node:crypto";
import { clamp } from "@scripts/module/util";

const trainTypes = ["Os", "Sp", "LE", "rj", "IC", "SC", "EN", "R", "EC"];

function hashNum(str: string) {
  const digest = createHash("sha256").update(str).digest();
  const hash = digest.readUInt32BE(0);
  return hash % 10000;
}

function hashTrainType(str: string) {
  const digest = createHash("sha256").update(str).digest();
  const hash = digest.readUInt32BE(0);
  return trainTypes[hash % trainTypes.length];
}

function hashPlatform(str: string) {
  const digest = createHash("sha256").update(str).digest();
  const hash = digest.readUInt32BE(0);
  const rail = clamp(hash % 10, 1, 10);

  const possiblePlatformLetter = ["A", "B", "C", "D", "E"];
  const platform = possiblePlatformLetter[hash % possiblePlatformLetter.length];

  return `${rail}${platform}`;
}

function hashNumPad(str: string) {
  return hashNum(str).toString().padStart(4, "0");
}

let departureSeed = 12345;
let departureMinutes = 7 * 60 + 53;

function getDeparture() {
  departureSeed = (departureSeed * 5 + 1) % 16;
  const time = `${Math.floor(departureMinutes / 60)
    .toString()
    .padStart(2, "0")}:${(departureMinutes % 60).toString().padStart(2, "0")}`;
  departureMinutes += (departureSeed % 3) + 1;

  return time;
}
