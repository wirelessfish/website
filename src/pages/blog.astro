---
import Page from "@layouts/Page.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";

import RssSvg from "@assets/icons/rss.svg";
import ValidRssButton from "@assets/buttons/valid-rss.webp";
import BlogCard from "@components/blog/BlogCard.svelte";

let blog = await getCollection("blog");
blog = blog.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<Page title="Blog" description="Sometimes I like to write about stuff">
  <section class="content-padding">
    <h2>
      Blog <a href="/rss.xml" class="rss-icon"><img src={RssSvg.src} alt="RSS icon" loading="lazy" /></a>
    </h2>
  </section>

  <section class="content-padding blog-cards">
    {blog.map((post) => <BlogCard client:load {post} />)}
  </section>

  <section class="content-padding">
    <a class="valid-rss" href="http://validator.w3.org/feed/check.cgi?url=https%3A//kabeyai.net/rss.xml">
      <img src={ValidRssButton.src} alt="[Valid RSS]" loading="lazy" title="Validate my RSS feed" />
    </a>
  </section>
</Page>

<style>
  .blog-cards {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .valid-rss,
  .valid-rss > img {
    width: fit-content;
    display: inline;
    padding: 0;
  }

  .rss-icon:hover,
  .valid-rss:hover {
    background: none;
  }

  .rss-icon > img {
    height: 1em;
    vertical-align: -0.2em;
    margin-left: 0.2em;
    display: inline;
  }
</style>
