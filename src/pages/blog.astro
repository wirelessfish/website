---
import Page from "@layouts/Page.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";

import RssSvg from "@assets/icons/rss.svg";

let blog = await getCollection("blog", (p) => !p.id.startsWith("cs/"));
blog.forEach((i) => {
  i.id = i.id.replace("en/", "");
});
blog = blog.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<Page title="Blog" description="Sometimes I like to write about stuff">
  <section class="content-padding">
    <h2>
      My writings <a href="/rss.xml" class="rss-icon"><img src={RssSvg.src} alt="RSS icon" loading="lazy" /></a>
    </h2>
  </section>

  <section class="content-padding">
    <ul>
      {
        blog.map((post) => (
          <li>
            <a href={"/blog/" + post.id}>{post.data.title}</a> [{format(post.data.published, "yyyy/MM/dd")}]
            <br />
            {post.data.description}
          </li>
        ))
      }
    </ul>
  </section>
</Page>

<style>
  .rss-icon:hover {
    background: none;
  }

  .rss-icon > img {
    height: 1em;
    vertical-align: -0.2em;
    margin-left: 0.2em;
    display: inline;
  }
</style>
