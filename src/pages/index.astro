---
import Page from "@layouts/Page.astro";

import eightyeight from "@data/eightyeight.json";
import EightyEightButton from "@components/EightyEightButton.astro";
import AeroButton from "@components/AeroButton.svelte";
import LatestBlogpost from "@components/index/LatestBlogpost.astro";
import WebRing from "@components/index/WebRing.astro";
---

<script src="../scripts/notify.ts"></script>

<Page
  title="WIRELESS.FISH"
  description="Sharky's personal webpage. The creature. Shark-infested website. wireless.fish 🐟"
>
  <section class="content-padding mobile-warning">
    <h2 style="text-align: center;">[ [ WARNING ] ]</h2>

    <p>
      This website was not made with mobile devices in mind! I have taken some action to make it usable on smaller
      screens, however the recommended screen size to have the full, intended experience is 1920x1080!
    </p>

    <p>Please bear that in mind as you browse my site, thanks :)</p>
  </section>

  <section class="heading">
    <h2>Welcome to my website</h2>
  </section>

  <section class="content-padding">
    <p>
      Hi<br />
      I'm a 1<sup>st</sup> year software engineering student that likes computers and does a bit of hobby programming.
    </p>
  </section>

  <section class="content-padding">
    <LatestBlogpost />
  </section>

  <section class="content-padding">
    <h3>Send me a push noitification!</h3>

    <noscript>Requires javascript!!</noscript>

    <p>
      Send me anything honestly, idk if there is a character limit. Didn't test that. This will be recieved on my mobile
      device "Nothing phone (4a)".
    </p>

    <form class="notify">
      <textarea id="notifyinput" placeholder="Hello, fishy" rows="1" spellcheck="false"></textarea>
      <AeroButton color="#1e78ff" id="notifysend">Send →</AeroButton>
    </form>
  </section>

  <section class="heading">
    <h2>Visit these sites</h2>
  </section>

  <section class="content-padding">
    <div class="eightyeight">
      {eightyeight.map((i) => <EightyEightButton src={i.src} href={i.href} alt={i.alt} css_classes={i.class} />)}
    </div>
  </section>

  <section class="content-padding">
    <h3>Also... webrings!</h3>

    <div class="webrings">
      <WebRing
        title="SSG ring"
        prev="https://jbc.lol/webrings/ssgring/redirect?slug=sharky&way=prev"
        next="https://jbc.lol/webrings/ssgring/redirect?slug=sharky&way=next"
        home="https://jbc.lol/webrings/ssgring/"
      />

      <WebRing
        title="no AI webring"
        prev="https://baccyflap.com/noai/?prv&s=shr"
        next="https://baccyflap.com/noai"
        home="https://baccyflap.com/noai/?nxt&s=shr"
      />

      <WebRing
        title="retronaut webring"
        prev="https://webring.dinhe.net/prev/https://wireless.fish/"
        next="https://webring.dinhe.net/next/https://wireless.fish/"
        home="https://webring.dinhe.net"
      />
    </div>
  </section>

  <section class="arivertisement">
    <iframe
      src="https://ad.ari.lt/ads/embed?from="
      sandbox="allow-popups allow-popups-to-escape-sandbox"
      referrerpolicy="no-referrer"
      title="An embed showing a silly image and author information."
      style="border:none;max-width:100%"
      width="722"
      height="98"
      loading="lazy"
      role="img"
    >
    </iframe>
  </section>
</Page>

<style>
  #notifyinput {
    flex: 1;
  }

  .eightyeight {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .webrings {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;
  }

  .notify {
    display: flex;
    flex-direction: row;
    gap: 1em;
    align-items: center;
  }

  .notify > form {
    height: 1em;
  }

  #contact-fluxer::before,
  #contact-discord::before,
  #contact-email::before {
    display: inline-block;
    height: 1.5em;
    margin-right: 0.5em;
    width: 1.5em;
  }

  #contact-fluxer::before {
    content: url("/assets/icons/fluxer_light.svg");
  }

  #contact-discord::before {
    content: url("/assets/icons/discord_light.svg");
  }
  #contact-email::before {
    content: url("/assets/icons/email_light.svg");
  }

  .heading {
    background-color: var(--blue);
    width: fit-content;
    padding: 0px 1em;
    padding-right: 2em;
  }

  .mybtn {
    background-color: var(--grey);
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    float: right;
    padding: 0px 4px 4px;
  }

  .contact-div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;

    div {
      align-items: center;
      display: flex;
    }
  }

  .arivertisement {
    display: flex;
    justify-content: center;
  }

  .mobile-warning {
    color: var(--orange);
    font-weight: bold;
    background-color: var(--darkorange);
    padding: 4px 8px;
    border: 1px solid var(--orange);
    border-radius: 4px;
    display: none;
  }

  @media (max-width: 500px) {
    .notify {
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    .notify > textarea {
      width: 100%;
    }

    .mybtn {
      float: none;
      width: max-content;
      margin-bottom: 8px;
    }
  }

  @media (max-width: 1000px) {
    .mobile-warning {
      display: block;
    }
  }
</style>
