---
import Page from "@layouts/Page.astro";

import eightyeight from "@data/eightyeight.json";
import EightyEightButton from "@components/EightyEightButton.astro";
import ThingMade from "@components/index/ThingMade.astro";
import AeroButton from "@components/AeroButton.svelte";
import FloatingImg from "@components/FloatingImg.svelte";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import { getEntry } from "astro:content";
import { format } from "date-fns";

let blog = await getCollection("blog");
blog = blog.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
let latestBlogpost = blog[0];
let latestDateFormatted = format(latestBlogpost.data.published, "yyyy/MM/dd");

let latestBlogDescriptionContent = await getEntry("blog_descriptions", latestBlogpost.id);

if (latestBlogDescriptionContent === undefined) {
  throw new Error(`ERROR: Blogpost id ${latestBlogpost.id} does NOT have an index description!`);
}

const { Content: LatestBlogDescription } = await render(latestBlogDescriptionContent);
---

<script src="../scripts/notify.ts"></script>

<style>
  #notifyinput {
    flex: 1;
  }

  .eightyeight {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .webrings {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;
  }

  .notify {
    display: flex;
    flex-direction: row;
    gap: 1em;
    align-items: center;
  }

  .notify > form {
    height: 1em;
  }

  #contact-fluxer::before,
  #contact-discord::before,
  #contact-email::before {
    display: inline-block;
    height: 1.5em;
    margin-right: 0.5em;
    width: 1.5em;
  }

  #contact-fluxer::before {
    content: url("/assets/icons/fluxer_light.svg");
  }

  #contact-discord::before {
    content: url("/assets/icons/discord_light.svg");
  }
  #contact-email::before {
    content: url("/assets/icons/email_light.svg");
  }

  .mybtn {
    background-color: var(--grey);
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    float: right;
    padding: 0px 4px 4px;
  }

  .contact-div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;

    div {
      align-items: center;
      display: flex;
    }
  }

  .arivertisement {
    display: flex;
    justify-content: center;
  }

  .mobile-warning {
    color: var(--orange);
    font-weight: bold;
    background-color: var(--darkorange);
    padding: 4px 8px;
    border: 1px solid var(--orange);
    border-radius: 4px;
    display: none;
  }

  @media (max-width: 500px) {
    .notify {
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    .notify > textarea {
      width: 100%;
    }

    .mybtn {
      float: none;
      width: max-content;
      margin-bottom: 8px;
    }
  }

  @media (max-width: 1000px) {
    .mobile-warning {
      display: block;
    }
  }
</style>

<Page
  title="WIRELESS.FISH"
  description="Sharky's personal webpage. The creature. Shark-infested website. wireless.fish 🐟"
>
  <section class="content-padding mobile-warning">
    <p>[ [ WARNING ] ]</p>

    <p>
      This website was not made with mobile devices in mind! I have taken some action to make it usable on smaller
      screens, however the recommended screen size to have the full, intended experience is 1920x1080!
    </p>

    <p>Please bear that in mind as you browse my site, thanks :)</p>
  </section>

  <section class="content-padding">
    <h2>Welcome to my website</h2>

    <p>
      I have migrated the whole website to Astro+Svelte AND did some styling. It wasn't easy or hard, the difficulty was
      just right. I'm glad I did it, because now I can FINALLY use components. To tell the truth, converting my
      <a href="/guestbook/">guestbook</a> page into components was a nightmare. But hey, it works!
    </p>

    <p>
      I have also created the <a href="/tools/">tools</a> page so that I don't have to search random websites for these things
      again. Feel free to suggest any additions!
    </p>
  </section>

  <ThingMade title={latestBlogpost.data.title} date={latestDateFormatted} image={latestBlogpost.data.og_img}>
    <LatestBlogDescription />

    <p>
      If you're interested in my rambling you can <a href={"/blog/" + latestBlogpost.id}>read the whole post ➞</a>
    </p>
  </ThingMade>

  <section class="content-padding">
    <h3>Send me a push noitification!</h3>

    <noscript>Requires javascript!!</noscript>

    <p>
      Send me anything honestly, idk if there is a character limit. Didn't test that. This will be recieved on my mobile
      device "Nothing phone (4a)".
    </p>

    <form class="notify">
      <textarea id="notifyinput" placeholder="Hello, fishy" rows="1" spellcheck="false"></textarea>
      <AeroButton color="#1e78ff" id="notifysend">Send →</AeroButton>
    </form>
  </section>

  <section class="content-padding">
    <h2>My thoughts on generative AI</h2>

    <p>It is a tool. It is <b>not a replacement</b> for human creativity.</p>

    <p>It should be utilized to automate mundane tasks to allow humans to focus on what they truly enjoy.</p>

    <p>
      This might come across as weird, considering I am a member of the
      <a href="https://baccyflap.com/noai/" target="_blank">no ai webring</a>. It is up to everyone to draw their line
      in the sand.
    </p>

    <p>
      I think that vibecoding is not a problem, as the only one who you're shooting in the foot is yourself. It is
      useful for small one-off scripts/components, but not for anything with a larger scale (such as a website and it's
      backend). With that being said, I need to rewrite my site's backend since a big portion of the code is AI
      generated (because I was too lazy to learn expressjs and sqlite libraries).
    </p>

    <p>
      Even though I personally use gen-AI to learn new frameworks, libraries and debug errors, not a single piece of
      content on my site is generated by artificial intelligence. <b>And it will stay that way until the end of time</b> (AI
      generated code makes up around 5% of this site - mostly helper scripts).
    </p>

    <p>- Sharky, 2026</p>
  </section>

  <section class="content-padding">
    <h2>Webrings</h2>

    <div class="webrings">
      <span>
        <a href="https://jbc.lol/webrings/ssgring/redirect?slug=sharky&way=prev" class="link-button link-alt">&larr;</a>
        <a target="_blank" href="https://jbc.lol/webrings/ssgring/" class="link-alt">SSG ring</a>
        <a href="https://jbc.lol/webrings/ssgring/redirect?slug=sharky&way=next" class="link-button link-alt">&rarr;</a>
      </span>

      <span>
        <a href="https://baccyflap.com/noai/?prv&s=shr" target="_top" title="previous" class="link-button link-alt"
          >&larr;</a
        >
        <a href="https://baccyflap.com/noai" target="_blank" class="link-alt">the no AI webring</a>
        <a href="https://baccyflap.com/noai/?nxt&s=shr" target="_top" title="next" class="link-button link-alt"
          >&rarr;</a
        >
      </span>

      <span>
        <a href="https://webring.dinhe.net/prev/https://wireless.fish/" class="link-button link-alt">&larr;</a>
        <a target="_blank" href="https://webring.dinhe.net" class="link-alt">retronaut webring</a>
        <a href="https://webring.dinhe.net/next/https://wireless.fish/" class="link-button link-alt">&rarr;</a>
      </span>
    </div>
  </section>

  <section class="content-padding">
    <h2>Visit these sites</h2>

    <div class="mybtn">
      <div style="text-align: center">My button!</div>
      <EightyEightButton src="/assets/button.svg" href="https://wireless.fish/" alt="wireless.fish" />
    </div>

    <div class="eightyeight">
      {eightyeight.map((i) => <EightyEightButton src={i.src} href={i.href} alt={i.alt} css_classes={i.class} />)}
    </div>
  </section>

  <section class="content-padding">
    <h2>Contact</h2>

    <div class="contact-div">
      <div id="contact-fluxer">Fluxer: sharky#3273</div>
      <div id="contact-discord">Discord: wireless.fish</div>
      <div id="contact-email">E-Mail: sharky@wireless.fish</div>
    </div>
  </section>

  <FloatingImg alt="a pyjama shark" src="/assets/sharks/pyjama.webp" top="50px" left="-50px" width="256px" />

  <section class="arivertisement">
    <iframe
      src="https://ad.ari.lt/ads/embed?from="
      sandbox="allow-popups allow-popups-to-escape-sandbox"
      referrerpolicy="no-referrer"
      title="An embed showing a silly image and author information."
      style="border:none;max-width:100%"
      width="722"
      height="98"
      loading="lazy"
      role="img"
    >
    </iframe>
  </section>
</Page>
