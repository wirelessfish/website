---
import Page from "@layouts/Page.astro";

import eightyeight from "@data/eightyeight.json";
import EightyEightButton from "@components/EightyEightButton.astro";
import AeroButton from "@components/AeroButton.svelte";
import Scrobble from "@components/index/Scrobble.svelte";
import BlogCard from "@components/blog/BlogCard.svelte";

import { getCollection } from "astro:content";
import { format } from "date-fns";

import RssSvg from "@assets/icons/rss.svg";

let blog = await getCollection("blog");
blog = blog.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
blog = blog.slice(0, 3); // last 3 posts
---

<script src="../scripts/notify.ts"></script>

<Page title="kabeyai.net" description="Sharky's personal webpage. The creature. Shark-infested website. kabeyai.net 🐟">
  <section class="content-padding mobile-warning">
    <h4>[ [ WARNING ] ]</h4>

    <p>The recommended screen size to have the full, intended experience is 1920x1080. Sorry mobile users!</p>
  </section>

  <section class="content-padding">
    <h2>Hey there</h2>

    <p>
      I'm a 1<sup>st</sup> year software engineering student from Czechia that likes computers and does a bit of hobby programming.
    </p>
  </section>

  <section class="content-padding">
    <h3>Contact</h3>

    <div class="contact">
      <div id="contact-email">sharky@kabeyai.net</div>
      <div id="contact-discord">somef1sh</div>
      <div id="contact-fluxer">sharky#3273</div>
      <div id="contact-fedi">sharky@neo.tokyonight.city</div>
    </div>
  </section>

  <section class="content-padding">
    <h3>Friends</h3>

    <div class="eightyeight">
      {
        eightyeight
          .filter((i) => i.friend && !i.hidden)
          .map((i) => <EightyEightButton src={i.src} href={i.href} alt={i.alt} />)
      }
    </div>

    <h3>Interesting places</h3>

    <div class="eightyeight">
      {
        eightyeight
          .filter((i) => !i.friend && !i.hidden)
          .map((i) => <EightyEightButton src={i.src} href={i.href} alt={i.alt} />)
      }
    </div>
  </section>

  <section class="content-padding blog">
    <h3>
      Recent blogposts <a href="/rss.xml" class="rss-icon"><img src={RssSvg.src} alt="RSS icon" loading="lazy" /></a>
    </h3>

    <div class="recent-blogposts">
      {
        blog.map((post) => (
          <BlogCard client:load post={post} />
          // <span>
          //   <a href={"/blog/" + post.id}>{post.data.title}</a> [{format(post.data.published, "yyyy/MM/dd")}]
          // </span>
        ))
      }
    </div>
  </section>

  <section>
    <Scrobble client:only />
  </section>

  <section class="arivertisement">
    <iframe
      src="https://ad.ari.lt/ads/embed?from=https%3A%2F%2Fkabeyai.net"
      sandbox="allow-popups allow-popups-to-escape-sandbox"
      referrerpolicy="no-referrer"
      title="An embed showing a silly image and author information."
      style="border:none;max-width:100%"
      width="722"
      height="98"
      loading="lazy"
      role="img"
    >
    </iframe>
  </section>
</Page>

<style>
  #notifyinput {
    flex: 1;
  }

  .blog {
    display: flex;
    flex-direction: column;
  }

  .eightyeight {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .notify {
    display: flex;
    flex-direction: row;
    gap: 1em;
    align-items: center;
  }

  .section-thing {
    padding: 8px 16px;
  }

  .notify > form {
    height: 1em;
  }

  .recent-blogposts {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #contact-fluxer::before,
  #contact-discord::before,
  #contact-email::before,
  #contact-fedi::before {
    display: inline;
    height: 1.3em;
    margin-right: 0.4em;
    width: 1.3em;
    vertical-align: -0.4em;
  }

  #contact-fluxer::before {
    content: url("/assets/icons/fluxer_light.svg");
  }

  #contact-discord::before {
    content: url("/assets/icons/discord_light.svg");
  }
  #contact-email::before {
    content: url("/assets/icons/email_light.svg");
  }
  #contact-fedi::before {
    content: url("/assets/icons/fedi.svg");
  }

  .heading {
    background-color: var(--blue);
    width: fit-content;
    padding: 0px 1em;
    padding-right: 2em;
  }

  .mybtn {
    background-color: var(--grey);
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    float: right;
    padding: 0px 4px 4px;
  }

  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .contact > * {
    padding: 4px;
    background-color: var(--darkergrey);
    display: flex;
    justify-content: center;
    align-items: center;
    border: 3px solid var(--darkgrey);
  }

  .arivertisement {
    display: flex;
    justify-content: center;
  }

  .mobile-warning {
    color: var(--orange);
    font-weight: bold;
    background-color: var(--darkorange);
    padding: 4px 8px;
    border: 1px solid var(--orange);
    display: none;
  }

  .rss-icon:hover {
    background: none;
  }

  .rss-icon > img {
    height: 1em;
    vertical-align: -0.2em;
    margin-left: 0.2em;
    display: inline;
  }

  @media (max-width: 500px) {
    .notify {
      flex-direction: column;
      align-items: center;
      width: 100%;
    }

    .notify > textarea {
      width: 100%;
    }

    .mybtn {
      float: none;
      width: max-content;
      margin-bottom: 8px;
    }
  }

  @media (max-width: 1000px) {
    .mobile-warning {
      display: block;
    }
  }
</style>
