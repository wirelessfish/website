---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const vinyls = await getCollection("vinyls", (p) => !p.id.startsWith("cs/"));

  return vinyls.map((v) => ({
    params: { slug: v.id.replace("cs/", "") },
    props: { v },
  }));
}
const { Content } = await render(Astro.props.v);
---

<Content />
