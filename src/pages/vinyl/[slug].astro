---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const vinyls = await getCollection("vinyls");

  return vinyls.map((v) => ({
    params: { slug: v.id },
    props: { v },
  }));
}
const { Content } = await render(Astro.props.v);
---

<Content />
