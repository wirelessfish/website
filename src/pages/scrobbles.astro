---
import Scrobbles from "../components/scrobbles/Scrobbles.svelte";
import Page from "../layouts/Page.astro";
---

<Page title="f1sh.cz scrobbles" description="See what music I listen to">
  <section class="content-padding">
    <h2>Scrobbles</h2>
    <p>This is what I've been listening to recently <noscript>JAVASCRIPT REQUIRED</noscript></p>
    <p>
      Data is sourced though <a href="https://last.fm" target="_blank">last.fm</a> (screw their api though, it sucks)
    </p>
  </section>

  <div class="content-padding">
    <Scrobbles locale="en" client:only />
  </div>
</Page>
