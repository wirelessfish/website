---
import Page from "@layouts/Page.astro";

import UUIDGen from "@components/tools/UUIDGen.svelte";
import QRGen from "@components/tools/QRGen.svelte";
---

<Page title="Tools" description="Various tools so that I don't keep searching for em online.">
  <section class="content-padding">
    <h2>Hey there...</h2>
    <p>
      If you'd like to see more tools or tool options added, shoot me ideas on fluxer, discord, email or even the
      notification box on the home page! Also please let me know if anything is broken or if you've found any bugs.
    </p>

    <p>All of these tools run directly in the browser, no data is being sent to my backend.</p>
  </section>

  <section class="content-padding">
    <h2>UUID Generator</h2>
  </section>

  <UUIDGen client:only />

  <section class="content-padding">
    <h2>QR Code Generator</h2>
  </section>

  <QRGen client:only />
</Page>
