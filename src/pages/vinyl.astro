---
import VinylBase from "@layouts/VinylBase.astro";
import { getCollection } from "astro:content";

import VinylEntry from "@components/vinyl/VinylEntry.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { localization } from "@i18n/index";

const locale = (Astro.currentLocale ?? "en") as keyof typeof localization;

let vinyls = await getCollection("vinyls", (v) => !v.id.includes("cs/"));
vinyls = vinyls.sort((a, b) => b.data.dateAdded.valueOf() - a.data.dateAdded.valueOf());
---

<VinylBase title="Vinyls" description="My collection of vinyls">
  <div class="content">
    <div class="vinyls">
      {vinyls.map((vinylEntry) => <VinylEntry locale="en" entry={vinylEntry} />)}
    </div>

    <div class="hint">(Click to see details)</div>
    <div class="home-link"><a href={getRelativeLocaleUrl(locale, "/")}>Home</a></div>
  </div>
</VinylBase>

<style>
  h2 {
    text-align: center;
    margin-bottom: 8px;
  }

  .content {
    max-width: fit-content;
    width: 100%;
  }

  .vinyls {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .hint {
    margin-top: 1rem;
    text-align: center;
    opacity: 30%;
  }

  .home-link {
    text-align: center;
  }
</style>
