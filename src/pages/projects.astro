---
import Page from "@layouts/Page.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";

let projects = await getCollection("projects");
projects = projects.sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---

<Page title="Projects" description="Sometimes I like to write about stuff">
  <section class="content-padding">
    <h2>My projects</h2>

    <p>I make things... sometimes</p>
  </section>

  <section class="projects">
    {
      projects.map((entry) => {
        let imgSrc = entry.data.og_img ?? "";
        let imgAlt = entry.data.og_img_alt ?? "This project does not have a thumbnail";

        return (
          <a class="entry" href={"/projects/" + entry.id}>
            <img src={imgSrc} alt={imgAlt} loading="lazy" />

            <div class="project-title">
              <div class="title">{entry.data.title}</div>
              <div class="date">{format(entry.data.published, "yyyy/MM/dd")}</div>
            </div>
          </a>
        );
      })
    }
  </section>
</Page>

<style>
  .projects {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    padding: 1em;
    gap: 16px;
    padding: 0px 16px;
  }

  .entry {
    position: relative;
    border: 1px solid var(--grey);
    background-color: var(--black);
    color: var(--white);
    text-decoration: none;
    padding: 0;
    border-radius: 0px;
    overflow: hidden;
    transition: 100ms;

    img {
      height: 200px;
      width: 100%;
      object-fit: cover;
      object-position: center;
    }
  }

  .entry:hover {
    scale: 103%;
    border-color: var(--lightergrey);
  }

  .project-title {
    position: absolute;
    bottom: 0;

    display: flex;
    justify-content: space-between;
    align-items: end;
    padding: 1px 4px;

    background: color-mix(in srgb, var(--grey) 50%, transparent);
    backdrop-filter: blur(2px);
    width: 100%;
  }

  .entry-body {
    padding: 0px 8px;
    padding-bottom: 4px;
  }

  .date {
    color: var(--lightergrey);
    font-variant-numeric: proportional-nums;
  }

  .title {
    font-size: large;
  }
</style>
